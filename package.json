{
  "name": "tlazolteotnia_tan",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "npm run build && vite preview --port 3000",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "deploy:dry-run": "npm run check && npm run build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types",
    "typecheck": "npm run generate-routes && tsc",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "fix": "biome check --write ./src ./scripts ./tests vite.config.ts vitest.config.ts",
    "lint": "biome lint ./src ./scripts ./tests vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/validate-content.ts",
    "og": "tsx scripts/generate-og-images.tsx",
    "og:check": "tsx scripts/generate-og-images.tsx --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run validate:content && npm run og:check"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "feed": "^6.0.0",
    "marked": "^18.0.5",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "three": "^0.185.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@cloudflare/vite-plugin": "^1.42.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^26",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.1",
    "satori": "^0.26.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.106.0"
  }
}
