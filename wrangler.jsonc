{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tlazolteotnia",
  "main": "./src/server.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "0rga.org", "custom_domain": true }],
  "upload_source_maps": true,
  "ratelimits": [
    {
      "name": "ISLAND_SESSION_RATE_LIMITER",
      "namespace_id": "2741958301",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "ISLAND_CONNECT_RATE_LIMITER",
      "namespace_id": "2741958302",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ISLAND_ROOM", "class_name": "IslandRoom" }]
  },
  "migrations": [{ "tag": "v1-island-room", "new_sqlite_classes": ["IslandRoom"] }],
  "observability": { "enabled": true }
}
