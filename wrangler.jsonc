{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tlazolteotnia",
  "main": "./src/server.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "0rga.org", "custom_domain": true }],
  "upload_source_maps": true,
  "ratelimits": [
    {
      "name": "REACTION_RATE_LIMITER",
      "namespace_id": "1834269501",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tlazolteotnia",
      "database_id": "88464a7d-1ec3-43a0-98ac-b4acfa63f567",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
